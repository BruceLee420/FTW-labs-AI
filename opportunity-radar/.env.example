# Opportunity Radar — local configuration.
# Copy to `.env` (git-ignored) or export these in your shell. Nothing here is
# required: every value has a safe local default.

# --- Server -----------------------------------------------------------------
# Loopback only by default. Binding any other host REQUIRES an auth token.
OPPORTUNITY_RADAR_HOST=127.0.0.1
OPPORTUNITY_RADAR_PORT=4747
# Optional shared secret. When set, every API call must send
# `Authorization: Bearer <token>` (the UI asks for it once and keeps it in
# sessionStorage). Required when the host is not loopback.
# OPPORTUNITY_RADAR_AUTH_TOKEN=
# Browser origins allowed to call the API (comma-separated). The site
# dashboard and the service's own pages are allowed by default.
OPPORTUNITY_RADAR_ALLOWED_ORIGINS=https://ftwlabs.ai,http://127.0.0.1:4747,http://localhost:4747

# --- Storage ----------------------------------------------------------------
# SQLite file. Relative paths resolve from the opportunity-radar/ directory.
OPPORTUNITY_RADAR_DB_PATH=./data/opportunity-radar.sqlite
# Folder containing your résumés (PDF, DOCX, TXT, MD). Private; git-ignored.
OPPORTUNITY_RADAR_RESUMES_DIR=./private/resumes/source
# Where generated drafts are exported when you ask for a file (git-ignored).
OPPORTUNITY_RADAR_OUTPUT_DIR=./private/output

# --- AI (advisory only) -----------------------------------------------------
# `ollama` (default, local) or `none` (rules + manual tracking only).
OPPORTUNITY_RADAR_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Default is an open-weights American model. Any model you have pulled works.
OLLAMA_MODEL=llama3.1
# Seconds to wait for a model response before treating AI as unavailable.
OPPORTUNITY_RADAR_AI_TIMEOUT_SECONDS=90

# --- Workflow defaults ------------------------------------------------------
# Calendar days after "applied" before a follow-up reminder is due.
OPPORTUNITY_RADAR_FOLLOW_UP_DAYS=7
# Max bytes fetched from a job URL; max redirects followed.
OPPORTUNITY_RADAR_FETCH_MAX_BYTES=2000000
OPPORTUNITY_RADAR_FETCH_MAX_REDIRECTS=5
OPPORTUNITY_RADAR_FETCH_TIMEOUT_SECONDS=15
# Extra hostnames to refuse when ingesting URLs (comma-separated). LinkedIn
# and other automation-prohibiting platforms are always refused.
# OPPORTUNITY_RADAR_URL_DENYLIST=

# --- Source adapters --------------------------------------------------------
# Greenhouse public job boards to sync, as board tokens (comma-separated).
# Example: OPPORTUNITY_RADAR_GREENHOUSE_BOARDS=examplecorp,anotherco
# OPPORTUNITY_RADAR_GREENHOUSE_BOARDS=
# Permitted RSS/Atom feeds to sync (comma-separated URLs).
# OPPORTUNITY_RADAR_RSS_FEEDS=

# --- Development only ---------------------------------------------------------
# Disable the per-client rate limits (tests set this; never needed in normal use).
# OPPORTUNITY_RADAR_DISABLE_RATE_LIMIT=true
